# Shadcnblocks / Studio (optional vendor CLI)
# Shadcnblocks Pro account email
SHADCNBLOCKS_EMAIL=
# Optional label for the API key (matches the "Key Name" shown in Shadcnblocks dashboard)
SHADCNBLOCKS_API_KEY_NAME=
# Required for @shadcnblocks private registry. Create at https://www.shadcnblocks.com/account
SHADCNBLOCKS_API_KEY=
# Shadcn Studio Pro account email (vendor script copies this to EMAIL for the Studio CLI)
SHADCNSTUDIO_EMAIL=
# Shadcn Studio license key (vendor script copies this to LICENSE_KEY)
SHADCNSTUDIO_LICENSE_KEY=

# Resend contact route
# Create at https://resend.com > API Keys
RESEND_API_KEY=
# Inbox that receives contact-form submissions
CONTACT_TO_EMAIL=
# Verified Resend sending address. Domain must be verified in Resend before sending.
# Plain email or "Display Name <noreply@yourdomain.com>" both work.
CONTACT_FROM_EMAIL=

# Sentry (see docs/SENTRY.md)
# DSN from Sentry project (Settings > Client Keys). NEXT_PUBLIC_ exposes to browser SDK.
NEXT_PUBLIC_SENTRY_DSN=
# From Sentry > User Settings > Auth Tokens. Needed for source-map uploads at build time.
SENTRY_AUTH_TOKEN=
# Sentry organization slug (e.g. "digital-dog" from digital-dog.sentry.io)
SENTRY_ORG=
# Sentry project slug (per-client, e.g. "acme-medspa-com")
SENTRY_PROJECT=

# Analytics (client-owned accounts; leave blank to disable)
# GA4 Measurement ID (G-XXXXXXXXXX) from client's GA4 > Admin > Data Streams
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Plausible site domain as configured in the client's Plausible account
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Fathom Site ID (e.g. ABCDEFGH) from client's Fathom > Sites
NEXT_PUBLIC_FATHOM_SITE_ID=

# Cloudflare deployment (for `pnpm run deploy` via OpenNext + Wrangler)
# https://dash.cloudflare.com -> right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=
# https://dash.cloudflare.com/profile/api-tokens (use the "Edit Cloudflare Workers" template).
# Optional if you've already run `pnpm dlx wrangler login` interactively on this machine.
CLOUDFLARE_API_TOKEN=

# Site identity
# Production canonical URL, no trailing slash (e.g. https://www.clientdomain.com).
# Used by sitemap.xml, robots.txt, canonical tags, and OG image base URL when those land.
NEXT_PUBLIC_SITE_URL=

# OpenNext / Wrangler local preview (optional)
NEXTJS_ENV=development

# Lighthouse CLI (optional override)
LIGHTHOUSE_URL=http://127.0.0.1:3000

# Client portal: Supabase (auth, database, storage)
# New subsystem on its own Supabase project. Key names mirror digital-dog-v2 so
# both projects stay consistent. Copy from https://supabase.com/dashboard.
# Project API URL (Settings > API > Project URL). Public, safe in the browser.
NEXT_PUBLIC_SUPABASE_PROJECT_URL=
# Publishable (anon) key (Settings > API Keys). Public; access is RLS-gated.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret service-role key. Bypasses RLS, so SERVER ONLY: never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Database password (Settings > Database). Secret.
SUPABASE_DB_PASSWORD=
# Project ref id + human-readable name (Settings > General). Metadata.
SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_NAME=
# JWT signing key. Only if we verify/issue JWTs (RLS access-token hook). Optional.
SUPABASE_JWT_SIGNING_KEY=
# DB connection strings, for the Supabase CLI + psql introspection:
# Direct URI (Settings > Database > Connection string). IPv6 only and likely
# UNREACHABLE from this VM, so prefer the pooler below.
SUPABASE_DIRECT_CONNECTION_STRING=
# IPv4 session pooler URI (same screen > Session pooler). Used for
# `supabase db push --db-url ...` and psql here. Secret (contains the password).
# Leave blank if unsure: I can derive it after `supabase link`.
SUPABASE_SESSION_POOLER_URL=
# Note: the Supabase auth redirect base reuses the existing NEXT_PUBLIC_SITE_URL above.

# Client portal: Stripe (redesign milestone payments + Care Plan subscriptions)
# Keys at https://dashboard.stripe.com/apikeys (use TEST keys in development).
# Stripe Test Key
NEXT_PUBLIC_STRIPE_TEST_PUBLISHABLE_KEY=
STRIPE_TEST_SECRET_KEY=

# Stripe Live Key
NEXT_PUBLIC_STRIPE_LIVE_PUBLISHABLE_KEY=
STRIPE_LIVE_SECRET_KEY=

# Webhook signing secret (whsec_...). Fill after creating the webhook endpoint
# (`stripe listen` locally, or Dashboard > Developers > Webhooks in prod).
STRIPE_WEBHOOK_SECRET=
# Recurring Care Plan price ids (Products > plan > price_...). Used server-side in
# Checkout, so kept non-public. Fill once the Stripe products exist. (One-time
# redesign payments are dynamic per-project amounts, so they need no fixed price id.)
STRIPE_PRICE_CARE_BASIC=
STRIPE_PRICE_CARE_GROWTH=
STRIPE_PRICE_CARE_PARTNER=

# Client portal: jobs + abuse protection
# Shared secret guarding the reminder cron route. Deploy target is Cloudflare, so
# the scheduler is a Cloudflare Cron Trigger (not Vercel Cron). Any random string
# works; I can generate one.
CRON_SECRET=
# Cloudflare Turnstile (captcha) for public portal forms ("resend my link", intake).
# https://dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# stitch.withgoogle.com api key for claude MCP test
STITCH.WITHGOOGLE_API_KEY=